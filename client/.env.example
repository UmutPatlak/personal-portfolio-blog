# ==========================================
# Frontend Environment Variables (.env.example)
# ==========================================

# Base URL for API requests.
# In local development with Vite proxy: "/api"
# In production with separate API domain: "https://api.umutpatlak.com/api"
# In production with Nginx reverse proxy on same domain: "/api"
VITE_API_URL=/api

# Production Website Canonical URL (used for Open Graph, Twitter Cards, Canonical links)
VITE_SITE_URL=https://umutpatlak.com
