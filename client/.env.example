# ==========================================
# Frontend Environment Variables (.env.example)
# ==========================================

# Base URL for API requests.
# In local development with Vite proxy: "/api"
# In production with separate API domain (e.g. Railway backend): "https://your-backend.up.railway.app/api"
# In production with Nginx reverse proxy or custom domain: "https://api.umutpatlak.com/api" or "/api"
VITE_API_URL=/api

# Production Website Canonical URL (used for Open Graph, Twitter Cards, Canonical links)
# Set this to your Vercel deployment URL or custom domain:
VITE_SITE_URL=https://umutpatlak.com
