# =================================================================
# Backend Environment Configuration (.env.example)
# =================================================================

# Node Environment & Port (Railway automatically sets PORT, no need to override)
NODE_ENV=production
PORT=3000

# CORS Whitelist
# Option 1: Comma-separated list in CORS_ORIGINS
# Option 2: Single frontend URL in FRONTEND_URL (e.g. your Vercel URL)
# Note: https://*.vercel.app is automatically allowed in production
CORS_ORIGINS=https://umutpatlak.com,https://www.umutpatlak.com
FRONTEND_URL=https://your-portfolio.vercel.app

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# Option A: Full Connection String (Railway PostgreSQL provides DATABASE_URL automatically)
# -----------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_password@roundhouse.proxy.rlwy.net:5432/railway
# Set DATABASE_SSL=true if your cloud database requires SSL (e.g. Supabase, Neon)
# DATABASE_SSL=false

# Option B: Individual Connection Parameters
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=umut_portfolio
DATABASE_SSL=false

# -----------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------
# Generate a strong 64-char random secret: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=7d

# -----------------------------------------------------------------
# Admin Initial Seed (used by `npm run db:seed`)
# -----------------------------------------------------------------
ADMIN_EMAIL=umutpatlak77@gmail.com
ADMIN_PASSWORD=change_this_admin_password_123
ADMIN_NAME=Umut Patlak
