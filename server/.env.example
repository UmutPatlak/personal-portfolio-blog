# =================================================================
# Backend Environment Configuration (.env.example)
# =================================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000

# CORS Whitelist (comma-separated list of allowed frontend domains)
# Example: https://umutpatlak.com,https://www.umutpatlak.com,http://localhost:5173
CORS_ORIGINS=https://umutpatlak.com,https://www.umutpatlak.com

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# Option A: Full Connection String (Recommended for Neon, Supabase, Railway, Render)
# -----------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/umut_portfolio

# Option B: Individual Connection Parameters
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=umut_portfolio

# -----------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------
# Generate a strong 64-char random secret: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=7d

# -----------------------------------------------------------------
# Admin Initial Seed (used by `npm run db:seed`)
# -----------------------------------------------------------------
ADMIN_EMAIL=umutpatlak77@gmail.com
ADMIN_PASSWORD=change_this_admin_password_123
ADMIN_NAME=Umut Patlak
